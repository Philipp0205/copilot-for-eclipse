Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: %bundle.name
Bundle-SymbolicName: copilot.eclipse.extensions;singleton:=true
Bundle-Version: 0.19.0.qualifier
Bundle-Vendor: %bundle.vendor
Bundle-Localization: plugin
Bundle-Activator: copilot.eclipse.extensions.CopilotExtensionsPlugin
Bundle-ActivationPolicy: lazy
Bundle-RequiredExecutionEnvironment: JavaSE-17
Automatic-Module-Name: copilot.eclipse.extensions
Export-Package: copilot.eclipse.extensions
Import-Package: org.osgi.framework;version="[1.10.0,2.0.0)"
Require-Bundle: com.microsoft.copilot.eclipse.core;bundle-version="0.19.0",
 com.microsoft.copilot.eclipse.ui;bundle-version="0.19.0",
 com.google.gson;bundle-version="2.10.1",
 org.eclipse.core.runtime;bundle-version="[3.30.0,4.0.0)",
 org.eclipse.core.resources;bundle-version="3.20.0",
 org.eclipse.ui;bundle-version="3.205.0",
 org.eclipse.jface;bundle-version="3.32.0"
